class Solution {
    public boolean isPowerOfFour(int n) {
        while(n>3)
        {
            if(n%4!=0)
            {
                return false;
            }
            else
            {
                n=n/4;
            }
        }
        if(n==1)
        {
            return true;
        }
        else
        {
            return false;
        }
    }
}
